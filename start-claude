#!/usr/bin/env bash
set -euo pipefail

script_path="$0"
if [[ -L "$script_path" ]]; then
  script_path="$(readlink "$script_path")"
fi
lab_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

# Under Git Bash / MSYS on Windows, every argument that looks like a Unix path
# (/home/claude, /github, /tmp:rw,noexec,...) is rewritten into a Windows path
# before docker.exe ever sees it, which corrupts the volume and tmpfs flags.
# Point Windows users at the PowerShell launcher instead of failing obscurely.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    cat >&2 <<EOF
On Windows, use the PowerShell launcher rather than this script:

  powershell -ExecutionPolicy Bypass -File "${lab_dir}/start-claude.ps1" <args>

Run install.ps1 once to get a claude-lab command on PATH.
EOF
    exit 69
    ;;
esac

# A raw "docker run" needs the image to exist already, which is only true after
# a project session has built it. Without this, the documented first step on a
# new machine ("claude-lab login") fails with "Unable to find image".
ensure_image() {
  if ! docker image inspect claude-lab-project >/dev/null 2>&1; then
    echo "[agent-lab] building the claude image (first run only)..." >&2
    PROJECT_DIR="$lab_dir" WORKSPACE_DIR=/workspace/agent-lab \
      docker compose -f "$lab_dir/claude-compose.yaml" build >&2
  fi
}

run_home_command() {
  ensure_image
  if [[ -t 0 && -t 1 ]]; then
    exec docker run --rm -it --init \
      --cap-drop ALL --security-opt no-new-privileges:true \
      --tmpfs /tmp:rw,noexec,nosuid,size=1g \
      --volume claude-lab-home:/home/claude \
      --volume agent-lab-github:/github \
      --volume agent-lab-gcloud:/gcloud \
      --env GH_CONFIG_DIR=/github/gh \
      --env GIT_CONFIG_GLOBAL=/github/gitconfig \
      --env CLOUDSDK_CONFIG=/gcloud \
      --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
      claude-lab-project "$@"
  fi
  exec docker run --rm --init \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,size=1g \
    --volume claude-lab-home:/home/claude \
    --volume agent-lab-github:/github \
    --volume agent-lab-gcloud:/gcloud \
    --env GH_CONFIG_DIR=/github/gh \
    --env GIT_CONFIG_GLOBAL=/github/gitconfig \
    --env CLOUDSDK_CONFIG=/gcloud \
    --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
    claude-lab-project "$@"
}

ensure_guidance() {
  ensure_image
  docker run --rm --init \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --volume claude-lab-home:/home/claude \
    claude-lab-project bash -lc 'mkdir -p /home/claude/.claude; test -e /home/claude/.claude/CLAUDE.md || cp /opt/agent-lab/guidance.md /home/claude/.claude/CLAUDE.md' >/dev/null
}

case "${1:-}" in
  login)
    shift
    run_home_command env BROWSER=echo claude auth login "$@"
    ;;
  status|logout)
    command="$1"
    shift
    run_home_command claude auth "$command" "$@"
    ;;
  github)
    shift
    exec "${lab_dir}/start-codex" github "$@"
    ;;
  gcloud)
    shift
    exec "${lab_dir}/start-codex" gcloud "$@"
    ;;
  gui)
    shift
    export AGENT_LAB_GUI=1
    ;;
  lume)
    shift
    exec "${lab_dir}/lume-lab" claude "$@"
    ;;
  -h|--help|help|"")
    echo "Usage: claude-lab /absolute/path/to/project"
    echo "       claude-lab <login|status|logout>"
    echo "       claude-lab github <login|setup-git|identity|status|logout>"
    echo "       claude-lab gcloud <login|firestore-login|status>"
    echo "       claude-lab gui /absolute/path/to/project"
    echo "       claude-lab lume /absolute/path/to/project"
    exit 0
    ;;
esac

if [[ $# -ne 1 || ! -d "$1" ]]; then
  echo "Usage: claude-lab /absolute/path/to/project"
  exit 64
fi

export PROJECT_DIR="$(cd "$1" && pwd -P)"
export WORKSPACE_DIR="/workspace/$(basename "$PROJECT_DIR")"
ensure_guidance
cd "$lab_dir"
if [[ "${AGENT_LAB_GUI:-0}" == 1 ]]; then
  # --service-ports is required: "docker compose run" otherwise ignores the
  # ports the service declares, so the desktop would be unreachable at
  # http://localhost:6080/vnc.html even though it started correctly.
  exec docker compose -p claude-lab-gui -f claude-compose.yaml -f compose.gui.yaml run --rm --service-ports project \
    /usr/local/bin/agent-lab-gui-entrypoint node /usr/local/bin/agent-lab-entrypoint.mjs \
    claude --dangerously-skip-permissions
fi
exec docker compose -f claude-compose.yaml run --rm project \
  node /usr/local/bin/agent-lab-entrypoint.mjs \
  claude --dangerously-skip-permissions
