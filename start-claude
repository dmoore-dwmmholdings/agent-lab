#!/usr/bin/env bash
set -euo pipefail

LAB_CLI=claude-lab
LAB_AGENT=Claude
LAB_COMPOSE=claude-compose.yaml
LAB_PROJECT=claude-lab
LAB_HOME_VOL=claude-lab-home
LAB_HOME_DIR=/home/claude
LAB_GUIDANCE=/home/claude/.claude/CLAUDE.md
LAB_CMD=claude
LAB_ARGS=(--dangerously-skip-permissions)

# $0 is normally a symlink in ~/.local/bin. Resolve the whole chain, including
# relative links, without depending on a `readlink -f` that older macOS lacks.
self="$0"
while [ -L "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
LAB_DIR="$(cd -P "$(dirname "$self")" && pwd)"
# shellcheck source=lab-common.sh
source "${LAB_DIR}/lab-common.sh"

case "${1:-}" in
  login|status|logout)
    subcommand="$1"
    shift
    lab_run_home_command claude auth "$subcommand" "$@"
    ;;
  github)
    shift
    lab_github "$@"
    ;;
  gcloud)
    shift
    lab_gcloud "$@"
    ;;
  build)
    shift
    lab_build_command "$@"
    ;;
  gui)
    shift
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch gui "$1"
    ;;
  lume)
    shift
    exec "${LAB_DIR}/lume-lab" claude "$@"
    ;;
  -h|--help|help|"")
    lab_usage
    exit 0
    ;;
  *)
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch headless "$1"
    ;;
esac
