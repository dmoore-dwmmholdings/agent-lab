#!/usr/bin/env bash
set -euo pipefail

vm_name="${AGENT_LAB_LUME_VM:-agent-lab-macos-cua}"
vm_password="${AGENT_LAB_LUME_PASSWORD:-lume}"
framewatch_version="${AGENT_LAB_FRAMEWATCH_VERSION:-0.8.3}"
if ! command -v lume >/dev/null 2>&1; then
  echo "Lume is required. Install it with: brew install lume" >&2
  exit 1
fi

ensure_vm() {
  if ! lume ls | awk 'NR>1 {print $1}' | grep -qx "$vm_name"; then
    echo "[agent-lab] creating macOS VM $vm_name (one-time download and 100 GB logical disk)..."
    lume pull macos-tahoe-cua:26.5.2 "$vm_name"
  fi
}

guest_project() {
  basename "$1"
}

wait_for_ssh() {
  local attempt
  for attempt in $(seq 1 90); do
    if lume ssh "$vm_name" 'true' >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  cat >&2 <<EOF
[agent-lab] The macOS VM booted, but SSH/Remote Login did not become ready.
Open its native window, wait for macOS setup to finish, then run:
  lume setup $vm_name --unattended tahoe
  lume stop $vm_name
  codex-lab lume <your-project>
EOF
  return 1
}

launch_agent() {
  local agent="$1" project="$2" guest_dir
  guest_dir="/Volumes/My Shared Files/$(guest_project "$project")"
  ensure_vm
  if lume ls | awk -v vm="$vm_name" '$1 == vm && $7 == "running" { found=1 } END { exit !found }'; then
    echo "[agent-lab] restarting its macOS VM to attach the selected project..."
    lume stop "$vm_name" >/dev/null
  fi
  lume run "$vm_name" --shared-dir "$project:rw" --display native --clipboard --detach >/dev/null
  echo "[agent-lab] waiting for macOS Remote Login..."
  wait_for_ssh
  echo "[agent-lab] preparing $agent and Framewatch inside the macOS VM..."
  if ! lume ssh "$vm_name" 'test -x /opt/homebrew/bin/brew'; then
    lume ssh "$vm_name" "printf '#!/bin/sh\\necho %s\\n' '$vm_password' >/tmp/agent-lab-askpass && chmod 700 /tmp/agent-lab-askpass && SUDO_ASKPASS=/tmp/agent-lab-askpass NONINTERACTIVE=1 /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"; rc=\$?; rm -f /tmp/agent-lab-askpass; exit \$rc"
  fi
  lume ssh "$vm_name" 'PATH=/opt/homebrew/bin:$PATH /opt/homebrew/bin/brew install node rust'
  lume ssh "$vm_name" 'PATH=/opt/homebrew/bin:$PATH /opt/homebrew/bin/npm install -g firebase-tools@15 pnpm'
  lume ssh "$vm_name" "PATH=/opt/homebrew/bin:\$PATH command -v framewatch >/dev/null 2>&1 || PATH=/opt/homebrew/bin:\$PATH /opt/homebrew/bin/cargo install --locked framewatch --version '$framewatch_version' --features macos"
  if [[ "$agent" == codex ]]; then
    lume ssh "$vm_name" 'PATH=/opt/homebrew/bin:$PATH /opt/homebrew/bin/npm install -g @openai/codex'
    lume ssh "$vm_name" "cd '$guest_dir' && PATH=/opt/homebrew/bin:\$PATH exec /opt/homebrew/bin/codex --dangerously-bypass-approvals-and-sandbox"
  else
    lume ssh "$vm_name" 'PATH=/opt/homebrew/bin:$PATH /opt/homebrew/bin/npm install -g @anthropic-ai/claude-code'
    lume ssh "$vm_name" "cd '$guest_dir' && PATH=/opt/homebrew/bin:\$PATH exec /opt/homebrew/bin/claude --dangerously-skip-permissions"
  fi
}

case "${1:-}" in
  create)
    ensure_vm
    ;;
  run)
    shift
    [[ $# -eq 1 && -d "$1" ]] || { echo "Usage: lume-lab run /absolute/path/to/project" >&2; exit 64; }
    project="$(cd "$1" && pwd -P)"
    exec lume run "$vm_name" --shared-dir "$project:rw" --display native --clipboard
    ;;
  codex|claude)
    agent="$1"
    shift
    [[ $# -eq 1 && -d "$1" ]] || { echo "Usage: lume-lab $agent /absolute/path/to/project" >&2; exit 64; }
    launch_agent "$agent" "$(cd "$1" && pwd -P)"
    ;;
  status)
    exec lume ls
    ;;
  stop)
    exec lume stop "$vm_name"
    ;;
  *)
    echo "Usage: lume-lab <create|run|codex|claude|status|stop>" >&2
    exit 64
    ;;
esac
