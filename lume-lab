#!/usr/bin/env bash
set -euo pipefail

vm_name="${AGENT_LAB_LUME_VM:-agent-lab-macos}"
if ! command -v lume >/dev/null 2>&1; then
  echo "Lume is required. Install it with: brew install lume" >&2
  exit 1
fi

ensure_vm() {
  if ! lume ls | awk 'NR>1 {print $1}' | grep -qx "$vm_name"; then
    echo "[agent-lab] creating macOS VM $vm_name (one-time download and 100 GB logical disk)..."
    lume create "$vm_name" --os macOS --ipsw latest --unattended tahoe --cpu 4 --memory 8GB --disk-size 100GB --display 1920x1080
  fi
}

guest_project() {
  basename "$1"
}

launch_agent() {
  local agent="$1" project="$2" guest_dir
  guest_dir="/Volumes/My Shared Files/$(guest_project "$project")"
  ensure_vm
  lume run "$vm_name" --shared-dir "$project:rw" --display native --clipboard --detach >/dev/null
  echo "[agent-lab] preparing $agent and Framewatch inside the macOS VM..."
  if [[ "$agent" == codex ]]; then
    lume ssh "$vm_name" "command -v brew >/dev/null || { echo 'Install Homebrew in the guest, then rerun codex-lab lume.' >&2; exit 1; }; brew list node >/dev/null 2>&1 || brew install node; npm install -g @openai/codex firebase-tools@15 pnpm; command -v framewatch >/dev/null || { brew list rust >/dev/null 2>&1 || brew install rust; cargo install --locked framewatch --features macos; }; cd '$guest_dir'; exec codex --dangerously-bypass-approvals-and-sandbox"
  else
    lume ssh "$vm_name" "command -v brew >/dev/null || { echo 'Install Homebrew in the guest, then rerun claude-lab lume.' >&2; exit 1; }; brew list node >/dev/null 2>&1 || brew install node; npm install -g @anthropic-ai/claude-code firebase-tools@15 pnpm; command -v framewatch >/dev/null || { brew list rust >/dev/null 2>&1 || brew install rust; cargo install --locked framewatch --features macos; }; cd '$guest_dir'; exec claude --dangerously-skip-permissions"
  fi
}

case "${1:-}" in
  create)
    lume create "$vm_name" --os macOS --ipsw latest --unattended tahoe --cpu 4 --memory 8GB --disk-size 100GB --display 1920x1080
    ;;
  run)
    shift
    [[ $# -eq 1 && -d "$1" ]] || { echo "Usage: lume-lab run /absolute/path/to/project" >&2; exit 64; }
    project="$(cd "$1" && pwd -P)"
    exec lume run "$vm_name" --shared-dir "$project:rw" --display native --clipboard
    ;;
  codex|claude)
    agent="$1"
    shift
    [[ $# -eq 1 && -d "$1" ]] || { echo "Usage: lume-lab $agent /absolute/path/to/project" >&2; exit 64; }
    launch_agent "$agent" "$(cd "$1" && pwd -P)"
    ;;
  status)
    exec lume ls
    ;;
  stop)
    exec lume stop "$vm_name"
    ;;
  *)
    echo "Usage: lume-lab <create|run|codex|claude|status|stop>" >&2
    exit 64
    ;;
esac
