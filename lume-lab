#!/usr/bin/env bash
# Native macOS path: run an agent inside a local Lume VM instead of a container.
# Use this only when the work genuinely needs macOS (Xcode, Apple frameworks,
# capturing real macOS windows). The Docker GUI path is faster for everything else.
set -euo pipefail

vm_name="${AGENT_LAB_LUME_VM:-agent-lab-macos-cua}"
vm_image="${AGENT_LAB_LUME_IMAGE:-macos-tahoe-cua:26.5.2}"
vm_user="${AGENT_LAB_LUME_USER:-lume}"
vm_password="${AGENT_LAB_LUME_PASSWORD:-lume}"
framewatch_version="${AGENT_LAB_FRAMEWATCH_VERSION:-0.8.5}"
brew_bin=/opt/homebrew/bin
# cargo installs framewatch into ~/.cargo/bin, so the guest PATH needs both.
# Deliberately unexpanded: $HOME and $PATH are evaluated inside the guest.
# shellcheck disable=SC2016
guest_path='/opt/homebrew/bin:$HOME/.cargo/bin:$PATH'

if ! command -v lume >/dev/null 2>&1; then
  echo "Lume is required. Install it with: brew install lume" >&2
  exit 1
fi

# Single-quote a value for safe interpolation into a remote shell command.
quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# `lume ssh` defaults to a 60 second command timeout and to the built-in `lume`
# credentials. Provisioning and the interactive agent session both run far past
# a minute, and the password must be forwarded or a guest whose password was
# changed (as the README advises) cannot be reached at all.
guest_run() {
  local timeout="$1"
  shift
  lume ssh "$vm_name" \
    --user "$vm_user" \
    --password "$vm_password" \
    --timeout "$timeout" \
    "$@"
}

guest_quick() { guest_run 60 "$@"; }
guest_long() { guest_run 0 "$@"; }

# `lume get` prints an error but still exits 0 for an unknown VM, so existence
# has to be decided from the payload rather than the status code.
vm_json() {
  lume get "$vm_name" --format json 2>/dev/null
}

vm_exists() {
  vm_json | grep -q "\"name\" : \"${vm_name}\""
}

vm_status() {
  vm_json | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# lume reports "sharedDirectories": null even while a directory is bound, so the
# running process's own arguments are the only reliable source for what a live
# VM is actually serving.
runner_pid() {
  pgrep -f "lume run .*${vm_name}" 2>/dev/null | head -1
}

runner_shared_dir() {
  ps -o command= -p "$1" 2>/dev/null |
    sed -n 's/.*--shared-dir \([^ ]*\).*/\1/p' |
    sed 's/:[a-z][a-z]*$//'
}

ensure_vm() {
  if ! vm_exists; then
    echo "[agent-lab] creating macOS VM $vm_name (one-time download, large)..." >&2
    lume pull "$vm_image" "$vm_name"
  fi
}

# `lume stop` returns before the VM process has released its locks, so an
# immediate `lume run` loses a race with it. Wait for the status to settle.
wait_for_stopped() {
  local _
  for _ in $(seq 1 60); do
    [[ "$(vm_status)" == stopped ]] && { sleep 2; return 0; }
    sleep 1
  done
  echo "[agent-lab] $vm_name did not reach a stopped state." >&2
  return 1
}

# `lume run --detach` reports success and returns 0 even when the VM then fails
# to boot; the real error only lands in the detach log. Poll for the status and
# surface that log rather than hanging in the SSH wait.
start_vm() {
  local project="$1" attempt log
  log="$HOME/Library/Logs/lume/${vm_name}.log"
  for attempt in 1 2 3; do
    lume run "$vm_name" --shared-dir "$project:rw" --display native --clipboard --detach >/dev/null 2>&1 || true
    local _
    for _ in $(seq 1 45); do
      [[ "$(vm_status)" == running ]] && return 0
      sleep 1
    done
    echo "[agent-lab] VM did not start (attempt ${attempt}/3)." >&2
    if [[ -f "$log" ]] && tail -40 "$log" | grep -qi "lock"; then
      echo "[agent-lab] a stale lock is still held; waiting before retrying..." >&2
      wait_for_stopped || true
      continue
    fi
    break
  done
  echo "[agent-lab] Could not start $vm_name. Last lines of $log:" >&2
  [[ -f "$log" ]] && tail -12 "$log" | sed 's/^/    /' >&2
  return 1
}

wait_for_ssh() {
  local _
  for _ in $(seq 1 90); do
    if guest_quick 'true' >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  cat >&2 <<EOF
[agent-lab] The macOS VM booted, but SSH/Remote Login did not become ready.
Open its native window, wait for macOS setup to finish, then run:
  lume setup $vm_name --unattended tahoe
  lume stop $vm_name
  codex-lab lume <your-project>
EOF
  return 1
}

# Homebrew's installer needs sudo. The askpass helper is transferred base64
# encoded so no part of the password is subject to shell quoting, but it is
# still briefly readable inside the guest: treat the guest password as a
# throwaway, never a reused secret.
install_homebrew() {
  local script script_b64
  script="#!/bin/sh
printf '%s\\n' $(quote "$vm_password")
"
  script_b64="$(printf '%s' "$script" | base64 | tr -d '\n')"
  guest_long "set -eu
umask 077
askpass=\$(mktemp /tmp/agent-lab-askpass.XXXXXX)
trap 'rm -f \"\$askpass\"' EXIT
printf '%s' ${script_b64} | base64 -d >\"\$askpass\"
chmod 700 \"\$askpass\"
SUDO_ASKPASS=\"\$askpass\" NONINTERACTIVE=1 /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
}

# Every provisioning step is guarded, so a normal launch is a handful of quick
# no-op checks rather than a full reinstall of Homebrew, Node, Rust, and the
# agent on every single session.
provision_guest() {
  local agent_package="$1"
  local formula entry package name

  if ! guest_quick "test -x ${brew_bin}/brew"; then
    echo "[agent-lab] installing Homebrew in the guest..." >&2
    install_homebrew
  fi

  for formula in node rust; do
    if ! guest_quick "${brew_bin}/brew list --formula $formula >/dev/null 2>&1"; then
      echo "[agent-lab] installing $formula in the guest..." >&2
      guest_long "PATH=${brew_bin}:\$PATH ${brew_bin}/brew install $formula"
    fi
  done

  # "installed package|name to probe for"
  for entry in "firebase-tools@15|firebase-tools" "pnpm|pnpm" "${agent_package}|${agent_package}"; do
    package="${entry%%|*}"
    name="${entry##*|}"
    if ! guest_quick "PATH=${brew_bin}:\$PATH ${brew_bin}/npm ls -g --depth 0 $(quote "$name") >/dev/null 2>&1"; then
      echo "[agent-lab] installing $package in the guest..." >&2
      guest_long "PATH=${brew_bin}:\$PATH ${brew_bin}/npm install -g $(quote "$package")"
    fi
  done

  if ! guest_quick "PATH=${guest_path} command -v framewatch >/dev/null 2>&1"; then
    echo "[agent-lab] building Framewatch ${framewatch_version} in the guest (slow, one time)..." >&2
    guest_long "PATH=${brew_bin}:\$PATH ${brew_bin}/cargo install --locked framewatch --version $(quote "$framewatch_version") --features macos"
  fi
}

launch_agent() {
  local agent="$1" project="$2" guest_dir agent_package agent_bin flag
  if [[ "$agent" == codex ]]; then
    agent_package=@openai/codex
    agent_bin=codex
    flag=--dangerously-bypass-approvals-and-sandbox
  else
    agent_package=@anthropic-ai/claude-code
    agent_bin=claude
    flag=--dangerously-skip-permissions
  fi
  guest_dir="/Volumes/My Shared Files/$(basename "$project")"

  ensure_vm

  local runner shared
  runner="$(runner_pid || true)"
  if [[ -n "$runner" ]]; then
    shared="$(runner_shared_dir "$runner")"
    if [[ "$(vm_status)" != running ]]; then
      cat >&2 <<EOF
[agent-lab] A \`lume run\` process for $vm_name is alive (PID $runner) but the VM
is not running, so it is a stale runner holding the VM's lock. Nothing can start
until it is cleared:
    kill $runner
EOF
      return 1
    fi
    if [[ "$shared" != "$project" ]]; then
      cat >&2 <<EOF
[agent-lab] $vm_name is already running (PID $runner) serving a different project:
    ${shared:-<unknown>}
A Lume VM has one runner and binds its shared directory at boot, so two projects
cannot use it at once. Stop that session, or point this one at a different VM
with AGENT_LAB_LUME_VM=<name>.
EOF
      return 1
    fi
  fi

  if [[ -n "$runner" ]]; then
    echo "[agent-lab] reusing the running VM; $project is already shared." >&2
  else
    # The shared directory is bound at boot, so switching projects means a
    # restart. Stopping is a no-op when it is already stopped.
    if [[ "$(vm_status)" != stopped ]]; then
      echo "[agent-lab] restarting $vm_name to attach $project..." >&2
      lume stop "$vm_name" >/dev/null 2>&1 || true
    fi
    wait_for_stopped
    start_vm "$project"
  fi
  echo "[agent-lab] waiting for macOS Remote Login..." >&2
  wait_for_ssh
  provision_guest "$agent_package"

  # Run the agent in the guest's own Terminal window rather than over SSH:
  # `lume ssh` gives the command no controlling terminal, and a full-screen TUI
  # needs one. Launch it with `open`, not AppleScript: controlling Terminal via
  # osascript needs macOS Automation consent, which cannot be granted from an
  # SSH session, so `do script` simply hangs on a fresh guest. `open` goes
  # through LaunchServices and needs no such permission.
  #
  # The wrapper is transferred base64 encoded so no path or flag has to survive
  # two layers of shell quoting.
  local script script_b64
  script="#!/bin/sh
cd $(quote "$guest_dir") || exit 1
export PATH=${guest_path}
exec ${brew_bin}/${agent_bin} ${flag}
"
  script_b64="$(printf '%s' "$script" | base64 | tr -d '\n')"
  guest_quick "set -eu
printf '%s' ${script_b64} | base64 -d >\$HOME/agent-lab-session.command
chmod 700 \$HOME/agent-lab-session.command
open -a Terminal \$HOME/agent-lab-session.command"
  echo "[agent-lab] $agent is running in the macOS VM's Terminal window." >&2
}

require_project() {
  local label="$1"
  shift
  [[ $# -eq 1 && -d "$1" ]] || {
    echo "Usage: lume-lab $label /absolute/path/to/project" >&2
    exit 64
  }
}

case "${1:-}" in
  create)
    ensure_vm
    ;;
  run)
    shift
    require_project run "$@"
    exec lume run "$vm_name" --shared-dir "$(cd "$1" && pwd -P):rw" --display native --clipboard
    ;;
  codex|claude)
    agent="$1"
    shift
    require_project "$agent" "$@"
    launch_agent "$agent" "$(cd "$1" && pwd -P)"
    ;;
  status)
    exec lume ls
    ;;
  stop)
    exec lume stop "$vm_name"
    ;;
  *)
    echo "Usage: lume-lab <create|run|codex|claude|status|stop>" >&2
    exit 64
    ;;
esac
