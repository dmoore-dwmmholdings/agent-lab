#!/usr/bin/env bash
set -euo pipefail

script_path="$0"
if [[ -L "$script_path" ]]; then
  script_path="$(readlink "$script_path")"
fi
lab_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

# Under Git Bash / MSYS on Windows, every argument that looks like a Unix path
# (/home/codex, /github, /tmp:rw,noexec,...) is rewritten into a Windows path
# before docker.exe ever sees it, which corrupts the volume and tmpfs flags.
# Point Windows users at the PowerShell launcher instead of failing obscurely.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    cat >&2 <<EOF
On Windows, use the PowerShell launcher rather than this script:

  powershell -ExecutionPolicy Bypass -File "${lab_dir}/start-codex.ps1" <args>

Run install.ps1 once to get a codex-lab command on PATH.
EOF
    exit 69
    ;;
esac

# A raw "docker run" needs the image to exist already, which is only true after
# a project session has built it. Without this, the documented first step on a
# new machine ("codex-lab login") fails with "Unable to find image".
ensure_image() {
  if ! docker image inspect codex-lab-project >/dev/null 2>&1; then
    echo "[agent-lab] building the codex image (first run only)..." >&2
    PROJECT_DIR="$lab_dir" WORKSPACE_DIR=/workspace/agent-lab \
      docker compose -f "$lab_dir/compose.yaml" build >&2
  fi
}

run_home_command() {
  ensure_image
  if [[ -t 0 && -t 1 ]]; then
    exec docker run --rm -it --init \
      --cap-drop ALL \
      --security-opt no-new-privileges:true \
      --tmpfs /tmp:rw,noexec,nosuid,size=1g \
      --volume codex-lab-home:/home/codex \
      --volume agent-lab-github:/github \
      --volume agent-lab-gcloud:/gcloud \
      --env GH_CONFIG_DIR=/github/gh \
      --env GIT_CONFIG_GLOBAL=/github/gitconfig \
      --env CLOUDSDK_CONFIG=/gcloud \
      --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
      codex-lab-project "$@"
  fi
  exec docker run --rm --init \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,size=1g \
    --volume codex-lab-home:/home/codex \
    --volume agent-lab-github:/github \
    --volume agent-lab-gcloud:/gcloud \
    --env GH_CONFIG_DIR=/github/gh \
    --env GIT_CONFIG_GLOBAL=/github/gitconfig \
    --env CLOUDSDK_CONFIG=/gcloud \
    --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
    codex-lab-project "$@"
}

ensure_guidance() {
  ensure_image
  docker run --rm --init \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --volume codex-lab-home:/home/codex \
    codex-lab-project bash -lc 'mkdir -p /home/codex/.codex; test -e /home/codex/.codex/AGENTS.md || cp /opt/agent-lab/guidance.md /home/codex/.codex/AGENTS.md' >/dev/null
}

case "${1:-}" in
  login)
    shift
    run_home_command codex login --device-auth "$@"
    ;;
  mcp)
    shift
    run_home_command codex mcp "$@"
    ;;
  github)
    shift
    case "${1:-}" in
      login)
        shift
        run_home_command bash -lc 'GH_BROWSER=echo gh auth login --hostname github.com --git-protocol https --web && gh auth setup-git --hostname github.com && (git config --global --unset-all url."https://github.com/".insteadOf || true) && git config --global --add url."https://github.com/".insteadOf "git@github.com:" && git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"'
        ;;
      setup-git)
        shift
        run_home_command bash -lc 'gh auth setup-git --hostname github.com && (git config --global --unset-all url."https://github.com/".insteadOf || true) && git config --global --add url."https://github.com/".insteadOf "git@github.com:" && git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"'
        ;;
      identity)
        shift
        if [[ $# -ne 2 ]]; then
          echo "Usage: codex-lab github identity 'Your Name' you@example.com"
          exit 64
        fi
        run_home_command sh -c 'git config --global user.name "$1" && git config --global user.email "$2"' sh "$1" "$2"
        ;;
      status|logout)
        command="$1"
        shift
        run_home_command gh auth "$command" "$@"
        ;;
      *)
        echo "Usage: codex-lab github <login|setup-git|identity|status|logout>"
        exit 64
        ;;
    esac
    ;;
  gcloud)
    shift
    case "${1:-}" in
      login)
        shift
        run_home_command gcloud auth login --no-launch-browser "$@"
        ;;
      firestore-login|adc-login)
        shift
        run_home_command gcloud auth application-default login --no-launch-browser "$@"
        ;;
      status)
        shift
        run_home_command gcloud auth list "$@"
        ;;
      *)
        echo "Usage: codex-lab gcloud <login|firestore-login|status>"
        exit 64
        ;;
    esac
    ;;
  gui)
    shift
    export AGENT_LAB_GUI=1
    ;;
  lume)
    shift
    exec "${lab_dir}/lume-lab" codex "$@"
    ;;
  -h|--help|help|"")
    echo "Usage: codex-lab /absolute/path/to/project"
    echo "       codex-lab login"
    echo "       codex-lab mcp <list|add|remove|login|logout> ..."
    echo "       codex-lab github <login|setup-git|identity|status|logout>"
    echo "       codex-lab gcloud <login|firestore-login|status>"
    echo "       codex-lab gui /absolute/path/to/project"
    echo "       codex-lab lume /absolute/path/to/project"
    exit 0
    ;;
esac

if [[ $# -ne 1 ]]; then
  echo "Usage: codex-lab /absolute/path/to/project"
  exit 64
fi

project_dir="$1"
if [[ ! -d "$project_dir" ]]; then
  echo "Not a directory: $project_dir"
  exit 66
fi

export PROJECT_DIR="$(cd "$project_dir" && pwd -P)"
export WORKSPACE_DIR="/workspace/$(basename "$PROJECT_DIR")"
ensure_guidance
cd "$lab_dir"
if [[ "${AGENT_LAB_GUI:-0}" == 1 ]]; then
  # --service-ports is required: "docker compose run" otherwise ignores the
  # ports the service declares, so the desktop would be unreachable at
  # http://localhost:6080/vnc.html even though it started correctly.
  exec docker compose -p codex-lab-gui -f compose.yaml -f compose.gui.yaml run --rm --service-ports project \
    /usr/local/bin/agent-lab-gui-entrypoint node /usr/local/bin/agent-lab-entrypoint.mjs \
    codex --dangerously-bypass-approvals-and-sandbox
fi
exec docker compose run --rm project \
  node /usr/local/bin/agent-lab-entrypoint.mjs \
  codex --dangerously-bypass-approvals-and-sandbox
