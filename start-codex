#!/usr/bin/env bash
set -euo pipefail

lab_dir="$(cd "$(dirname "$0")" && pwd -P)"

run_home_command() {
  if [[ -t 0 && -t 1 ]]; then
    exec docker run --rm -it --init \
      --cap-drop ALL \
      --security-opt no-new-privileges:true \
      --tmpfs /tmp:rw,noexec,nosuid,size=1g \
      --volume codex-lab-home:/home/codex \
      --volume agent-lab-github:/github \
      --volume agent-lab-gcloud:/gcloud \
      --env GH_CONFIG_DIR=/github/gh \
      --env GIT_CONFIG_GLOBAL=/github/gitconfig \
      --env CLOUDSDK_CONFIG=/gcloud \
      --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
      codex-lab-project "$@"
  fi
  exec docker run --rm --init \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,size=1g \
    --volume codex-lab-home:/home/codex \
    --volume agent-lab-github:/github \
    --volume agent-lab-gcloud:/gcloud \
    --env GH_CONFIG_DIR=/github/gh \
    --env GIT_CONFIG_GLOBAL=/github/gitconfig \
    --env CLOUDSDK_CONFIG=/gcloud \
    --env GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json \
    codex-lab-project "$@"
}

ensure_guidance() {
  docker run --rm --init \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --volume codex-lab-home:/home/codex \
    codex-lab-project bash -lc 'mkdir -p /home/codex/.codex; test -e /home/codex/.codex/AGENTS.md || cp /opt/agent-lab/guidance.md /home/codex/.codex/AGENTS.md' >/dev/null
}

case "${1:-}" in
  login)
    shift
    run_home_command codex login --device-auth "$@"
    ;;
  mcp)
    shift
    run_home_command codex mcp "$@"
    ;;
  github)
    shift
    case "${1:-}" in
      login)
        shift
        run_home_command bash -lc 'GH_BROWSER=echo gh auth login --hostname github.com --git-protocol https --web && gh auth setup-git --hostname github.com && (git config --global --unset-all url."https://github.com/".insteadOf || true) && git config --global --add url."https://github.com/".insteadOf "git@github.com:" && git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"'
        ;;
      setup-git)
        shift
        run_home_command bash -lc 'gh auth setup-git --hostname github.com && (git config --global --unset-all url."https://github.com/".insteadOf || true) && git config --global --add url."https://github.com/".insteadOf "git@github.com:" && git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"'
        ;;
      status|logout)
        command="$1"
        shift
        run_home_command gh auth "$command" "$@"
        ;;
      *)
        echo "Usage: codex-lab github <login|setup-git|status|logout>"
        exit 64
        ;;
    esac
    ;;
  gcloud)
    shift
    case "${1:-}" in
      login)
        shift
        run_home_command gcloud auth login --no-launch-browser "$@"
        ;;
      firestore-login|adc-login)
        shift
        run_home_command gcloud auth application-default login --no-launch-browser "$@"
        ;;
      status)
        shift
        run_home_command gcloud auth list "$@"
        ;;
      *)
        echo "Usage: codex-lab gcloud <login|firestore-login|status>"
        exit 64
        ;;
    esac
    ;;
  -h|--help|help|"")
    echo "Usage: codex-lab /absolute/path/to/project"
    echo "       codex-lab login"
    echo "       codex-lab mcp <list|add|remove|login|logout> ..."
    echo "       codex-lab github <login|setup-git|status|logout>"
    echo "       codex-lab gcloud <login|firestore-login|status>"
    exit 0
    ;;
esac

if [[ $# -ne 1 ]]; then
  echo "Usage: codex-lab /absolute/path/to/project"
  exit 64
fi

project_dir="$1"
if [[ ! -d "$project_dir" ]]; then
  echo "Not a directory: $project_dir"
  exit 66
fi

export PROJECT_DIR="$(cd "$project_dir" && pwd -P)"
export WORKSPACE_DIR="/workspace/$(basename "$PROJECT_DIR")"
ensure_guidance
cd "$lab_dir"
exec docker compose run --rm project \
  node /usr/local/bin/agent-lab-entrypoint.mjs \
  codex --dangerously-bypass-approvals-and-sandbox
