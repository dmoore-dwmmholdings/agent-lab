#!/usr/bin/env bash
set -euo pipefail

LAB_CLI=codex-lab

# $0 is normally a symlink in ~/.local/bin. Resolve the whole chain, including
# relative links, without depending on a `readlink -f` that older macOS lacks.
self="$0"
while [ -L "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
LAB_DIR="$(cd -P "$(dirname "$self")" && pwd)"
# shellcheck source=lab-common.sh
source "${LAB_DIR}/lab-common.sh"
lab_select_agent codex

case "${1:-}" in
  login)
    shift
    lab_run_home_command codex login --device-auth "$@"
    ;;
  # `agent-lab status|logout` fans out to both launchers, so these have to exist
  # here too. Codex spells them differently from Claude: status hangs off
  # `login`, logout is top level.
  status)
    shift
    lab_run_home_command codex login status "$@"
    ;;
  logout)
    shift
    lab_run_home_command codex logout "$@"
    ;;
  mcp)
    shift
    lab_run_home_command codex mcp "$@"
    ;;
  github)
    shift
    lab_github "$@"
    ;;
  gcloud)
    shift
    lab_gcloud "$@"
    ;;
  build)
    shift
    lab_build_command "$@"
    ;;
  gui)
    shift
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch gui "$1"
    ;;
  lume)
    shift
    exec "${LAB_DIR}/lume-lab" codex "$@"
    ;;
  -h|--help|help|"")
    lab_usage
    exit 0
    ;;
  *)
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch headless "$1"
    ;;
esac
