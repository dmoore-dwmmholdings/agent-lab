#!/usr/bin/env bash
set -euo pipefail

LAB_CLI=codex-lab

# $0 is normally a symlink in ~/.local/bin. Resolve the whole chain, including
# relative links, without depending on a `readlink -f` that older macOS lacks.
self="$0"
while [ -L "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
LAB_DIR="$(cd -P "$(dirname "$self")" && pwd)"
# shellcheck source=lab-common.sh
source "${LAB_DIR}/lab-common.sh"
lab_select_agent codex

# Under Git Bash / MSYS on Windows, every argument that looks like a Unix path
# (/home/codex, /github, /tmp:rw,noexec,...) is rewritten into a Windows path
# before docker.exe ever sees it, which corrupts the volume and tmpfs flags.
# Point Windows users at the PowerShell launcher instead of failing obscurely.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    cat >&2 <<EOF
On Windows, use the PowerShell launcher rather than this script:

  powershell -ExecutionPolicy Bypass -File "${LAB_DIR}/start-codex.ps1" <args>

Run install.ps1 once to get a codex-lab command on PATH.
EOF
    exit 69
    ;;
esac

case "${1:-}" in
  login)
    shift
    lab_run_home_command codex login --device-auth "$@"
    ;;
  # `agent-lab status|logout` fans out to both launchers, so these have to exist
  # here too. Codex spells them differently from Claude: status hangs off
  # `login`, logout is top level.
  status)
    shift
    lab_run_home_command codex login status "$@"
    ;;
  logout)
    shift
    lab_run_home_command codex logout "$@"
    ;;
  mcp)
    shift
    lab_run_home_command codex mcp "$@"
    ;;
  # Internal, used by `agent-lab mcp import|add`: append a base64-encoded TOML
  # table for one server to the lab's config.toml and confirm Codex can read
  # it back. The generator removed any previous definition of the name first.
  mcp-config)
    shift
    [[ "${1:-}" == append && $# -eq 3 ]] || { lab_usage >&2; exit 64; }
    lab_run_home_command sh -c '
      set -e
      mkdir -p "$HOME/.codex"
      printf "%s" "$2" | base64 -d >>"$HOME/.codex/config.toml"
      codex mcp get "$1" >/dev/null
    ' sh "$2" "$3"
    ;;
  github)
    shift
    lab_github "$@"
    ;;
  gcloud)
    shift
    lab_gcloud "$@"
    ;;
  build)
    shift
    lab_build_command "$@"
    ;;
  gui)
    shift
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch gui "$1"
    ;;
  lume)
    shift
    exec "${LAB_DIR}/lume-lab" codex "$@"
    ;;
  -h|--help|help|"")
    lab_usage
    exit 0
    ;;
  *)
    [[ $# -eq 1 ]] || { lab_usage >&2; exit 64; }
    lab_launch headless "$1"
    ;;
esac
